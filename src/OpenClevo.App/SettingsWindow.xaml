<Window x:Class="OpenClevo.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenClevo.Localization"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="500" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Border Margin="24" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
            Padding="26,18,26,26" MouseLeftButtonDown="Drag">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{loc:T settings.title}" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Light" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Muted}" FontSize="12" Click="Close_Click" ToolTip="{loc:T common.close}"/>
            </Grid>

            <Border Style="{StaticResource Group}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="22,16">
                        <TextBlock Text="{loc:T settings.language}" VerticalAlignment="Center"/>
                        <WrapPanel x:Name="LangBar" Width="300" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource Hairline}" Margin="22,0"/>
                    <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" Margin="22,18" Click="Startup_Click">
                        <TextBlock Text="{loc:T settings.startup}"/>
                    </CheckBox>
                    <Border Style="{StaticResource Hairline}" Margin="22,0"/>
                    <CheckBox x:Name="TrayToggle" Style="{StaticResource Toggle}" Margin="22,18" Click="Tray_Click">
                        <TextBlock Text="{loc:T settings.tray}"/>
                    </CheckBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
