<Application x:Class="OpenClevo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OpenClevo.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- slot 0 is swapped for Light.xaml at start-up / when Windows changes theme -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ModeAccent" Color="#0A84FF"/>
            <SolidColorBrush x:Key="ModeOnAccent" Color="White"/>
            <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
            <!-- instrument-panel face for numerals and small caps labels (ships with Windows) -->
            <FontFamily x:Key="Gauge">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- Type: 13 body, 12 captions, 56 hero numerals. One family. -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="Numeric" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

            <!-- Grouped surface: no border, one corner radius, hairline separators inside -->
            <Style x:Key="Group" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style x:Key="Hairline" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource Line}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Segmented control item (power mode, tabs, fan mode, brightness). Put in a Border with SegBg, CornerRadius 10, Padding 2 -->
            <Style x:Key="Segment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SegThumb}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                    <Setter TargetName="b" Property="Effect">
                                        <Setter.Value><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.16" Color="Black"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segment whose selected background is a SlideThumb behind the items -->
            <Style x:Key="SlideSegment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Power-mode word: thin large text; selected = coloured letters (see Controls/LetterText) -->
            <Style x:Key="ModeWord" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,34,0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <c:LetterText x:Name="lt" Text="{TemplateBinding Content}" SelectedColor="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="lt" Property="Hover" Value="True"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="lt" Property="Selected" Value="True"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- CPU Fan / GPU Fan tab: plain text; the selected one takes the colour in Tag, with a 2 px line under it -->
            <Style x:Key="FanTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="12,6">
                                <TextBlock x:Name="cp" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="cp" Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Side rail page button: icon only, selected = lighter tile + accent tick -->
            <Style x:Key="RailBtn" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="b" Background="Transparent" CornerRadius="6"/>
                                <Border x:Name="tick" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="-10,0,0,0" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SegBg}"/>
                                    <Setter TargetName="tick" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Large segmented control (power mode) -->
            <Style x:Key="SegmentLg" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ModeOnAccent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pill option (keyboard effects): neutral, selected = accent fill -->
            <Style x:Key="Chip" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="{DynamicResource CardHi}" CornerRadius="4" Padding="14,6">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Buttons: filled rounded rectangle, no border; hover = 8 % overlay of the text color -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Background" Value="{DynamicResource CardHi}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                                <Border x:Name="ov" Background="{TemplateBinding Foreground}" CornerRadius="4" Opacity="0"/>
                                <ContentPresenter Margin="16,6" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ov" Property="Opacity" Value="0.08"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ov" Property="Opacity" Value="0.16"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHi}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Line}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            </Style>

            <!-- Switch: label left, switch right -->
            <Style x:Key="Toggle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Border x:Name="track" Grid.Column="1" Width="40" Height="20" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource Muted}" BorderThickness="1">
                                    <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4,0"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="knob" Property="Width" Value="14"/><Setter TargetName="knob" Property="Height" Value="14"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slider: 4 px track, accent fill, white thumb with a soft shadow -->
            <Style TargetType="Slider">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="28">
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackOff}" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="22" Height="22">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Width="22" Height="22">
                                                        <Ellipse Fill="{DynamicResource CardHi}" Stroke="{DynamicResource Line}" StrokeThickness="1"/>
                                                        <Ellipse x:Name="dot" Width="12" Height="12" Fill="{DynamicResource Accent}"/>
                                                        <Border x:Name="bubble" Visibility="Collapsed" Background="{DynamicResource CardHi}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                                CornerRadius="4" Padding="7,2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-32,0,0" IsHitTestVisible="False">
                                                            <TextBlock FontSize="12" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="dot" Property="Width" Value="14"/><Setter TargetName="dot" Property="Height" Value="14"/>
                                                            <Setter TargetName="bubble" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="dot" Property="Width" Value="10"/><Setter TargetName="dot" Property="Height" Value="10"/>
                                                            <Setter TargetName="bubble" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
