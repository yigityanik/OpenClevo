<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OpenClevo</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\openclevo.ico</ApplicationIcon>
    <!-- what Windows shows in the file's Details tab and in Apps &amp; features -->
    <Product>OpenClevo</Product>
    <AssemblyTitle>OpenClevo</AssemblyTitle>
    <Company>Yiğit Emre Yanık</Company>
    <Authors>Yiğit Emre Yanık</Authors>
    <Copyright>© 2026 Yiğit Emre Yanık</Copyright>
    <Description>Open-source control for Clevo laptops: fans, power modes and keyboard backlight.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms are both enabled (WinForms only for the tray icon): avoid ambiguous global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClevo.Core\OpenClevo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text per language, embedded as langs/tr.json, langs/en.json (see Localization/Loc.cs) -->
    <EmbeddedResource Include="..\..\langs\*.json" LogicalName="langs/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
