<Window x:Class="OpenClevo.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="456" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Border Margin="24" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
            Padding="26,24,26,20" MouseLeftButtonDown="Drag">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight" Margin="0,24,0,0"/>
        </StackPanel>
    </Border>
</Window>
