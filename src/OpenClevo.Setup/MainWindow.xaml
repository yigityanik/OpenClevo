<Window xmlns:loc="clr-namespace:OpenClevo.Localization" x:Class="OpenClevo.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:T setup.window_title}" Width="520" Height="340" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Border Margin="10" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" MouseLeftButtonDown="Drag">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title row: product name left, close right -->
            <Grid Height="40">
                <TextBlock Text="OpenClevo" FontFamily="{StaticResource Display}" FontSize="14" FontWeight="Light" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="40" Height="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" FontSize="12" Click="Close_Click" ToolTip="{loc:T common.close}"/>
            </Grid>

            <!-- pages -->
            <Grid Grid.Row="1" Margin="32,4,32,0">
                <!-- 1 · welcome -->
                <!-- language picker: a vertical column, scroll (or click) moves the selection; the chosen language is big -->
                <StackPanel x:Name="PageWelcome" VerticalAlignment="Top" Margin="-32,6,-32,0" PreviewMouseWheel="Welcome_Wheel">
                    <TextBlock x:Name="HeadingText" Text="{loc:T setup.heading}" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DescText" Text="{loc:T setup.welcome_body}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    <!-- a Canvas gives the strip all the height it needs: in a normal panel WPF clips it to the 120 px view -->
                    <Grid x:Name="VerticalPicker" Height="120" Margin="0,19,0,0">
                        <Border x:Name="VStripHost" ClipToBounds="True" Background="Transparent" MouseLeftButtonUp="Strip_Click" Cursor="Hand">
                            <Canvas>
                                <StackPanel x:Name="VStrip" Orientation="Vertical" Width="{Binding ActualWidth, ElementName=VStripHost}">
                                    <StackPanel.RenderTransform><TranslateTransform x:Name="VStripMove"/></StackPanel.RenderTransform>
                                </StackPanel>
                            </Canvas>
                        </Border>
                        <StackPanel x:Name="VDots" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"/>
                    </Grid>
                </StackPanel>

                <!-- 2 · options -->
                <StackPanel x:Name="PageOptions" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T setup.options}" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Light" Margin="0,0,0,18"/>
                    <CheckBox x:Name="OptStartup" Style="{StaticResource Check}" IsChecked="True"><TextBlock Text="{loc:T settings.startup}"/></CheckBox>
                    <CheckBox x:Name="OptTray" Style="{StaticResource Check}" IsChecked="True"><TextBlock Text="{loc:T setup.opt_tray}"/></CheckBox>
                    <CheckBox x:Name="OptDesktop" Style="{StaticResource Check}"><TextBlock Text="{loc:T setup.opt_desktop}"/></CheckBox>
                </StackPanel>

                <!-- 3 · install -->
                <StackPanel x:Name="PageInstall" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T setup.installing}" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Light"/>
                    <TextBlock x:Name="StepText" Text="{loc:T setup.preparing}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" Margin="0,18,0,0" HorizontalAlignment="Stretch">
                        <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                </StackPanel>

                <!-- 5 · done -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T common.ok}" FontFamily="{StaticResource Display}" FontSize="42" FontWeight="Light"/>
                    <TextBlock x:Name="PathText" Foreground="{StaticResource Muted}" Margin="0,10,0,18" FontFamily="Consolas"/>
                    <CheckBox x:Name="OptLaunch" Style="{StaticResource Check}" IsChecked="True"><TextBlock Text="{loc:T tray.open}"/></CheckBox>
                </StackPanel>
            </Grid>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="32,0,32,26">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnBack" Content="{loc:T common.back}" Style="{StaticResource Btn}" Click="Back_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="BtnCancel" Content="{loc:T common.abort}" Style="{StaticResource Btn}" Click="Close_Click"/>
                </StackPanel>
                <!-- scroll hint of the language page: centred between the footer buttons, clear of the language list -->
                <Border x:Name="WheelFrame" Width="14" Height="22" BorderBrush="{StaticResource Muted}" BorderThickness="1.5" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse x:Name="Wheel" Width="2" Height="4" Fill="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                </Border>
                <Button x:Name="BtnNext" Content="{loc:T common.next}" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" MinWidth="104" Click="Next_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
