<Window x:Class="OpenClevo.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClevo Kurulum" Width="520" Height="340" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Border Margin="10" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" MouseLeftButtonDown="Drag">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title row: product name left, close right -->
            <Grid Height="40">
                <TextBlock Text="OpenClevo" FontFamily="{StaticResource Display}" FontSize="14" FontWeight="Light" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="40" Height="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" FontSize="12" Click="Close_Click" ToolTip="Kapat"/>
            </Grid>

            <!-- pages -->
            <Grid Grid.Row="1" Margin="32,4,32,0">
                <!-- 1 · welcome -->
                <StackPanel x:Name="PageWelcome" VerticalAlignment="Center">
                    <TextBlock Text="Kurulum" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Light"/>
                    <TextBlock Text="Fan, güç modu ve klavye ışığı denetimi." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 2 · options -->
                <StackPanel x:Name="PageOptions" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Ek seçenekler" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Light" Margin="0,0,0,18"/>
                    <CheckBox x:Name="OptStartup" Style="{StaticResource Check}" IsChecked="True"><TextBlock Text="Windows ile başlat"/></CheckBox>
                    <CheckBox x:Name="OptTray" Style="{StaticResource Check}" IsChecked="True"><TextBlock Text="Kapatınca tepsiye küçült"/></CheckBox>
                    <CheckBox x:Name="OptDesktop" Style="{StaticResource Check}"><TextBlock Text="Masaüstü kısayolu oluştur"/></CheckBox>
                </StackPanel>

                <!-- 3 · install -->
                <StackPanel x:Name="PageInstall" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Kuruluyor" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Light"/>
                    <TextBlock x:Name="StepText" Text="Hazırlanıyor…" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" Margin="0,18,0,0" HorizontalAlignment="Stretch">
                        <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                </StackPanel>

                <!-- 5 · done -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Tamam" FontFamily="{StaticResource Display}" FontSize="42" FontWeight="Light"/>
                    <TextBlock x:Name="PathText" Foreground="{StaticResource Muted}" Margin="0,10,0,18" FontFamily="Consolas"/>
                    <CheckBox x:Name="OptLaunch" Style="{StaticResource Check}" IsChecked="True"><TextBlock Text="OpenClevo'yu aç"/></CheckBox>
                </StackPanel>
            </Grid>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="32,0,32,26">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnBack" Content="Geri" Style="{StaticResource Btn}" Click="Back_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="BtnCancel" Content="İptal" Style="{StaticResource Btn}" Click="Close_Click"/>
                </StackPanel>
                <Button x:Name="BtnNext" Content="İleri" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" MinWidth="104" Click="Next_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
