<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OpenClevo-Setup</AssemblyName>
    <ApplicationIcon>..\..\assets\openclevo.ico</ApplicationIcon>
    <Product>OpenClevo Setup</Product>
    <AssemblyTitle>OpenClevo Setup</AssemblyTitle>
    <Company>Yiğit Emre Yanık</Company>
    <Authors>Yiğit Emre Yanık</Authors>
    <Copyright>© 2026 Yiğit Emre Yanık</Copyright>
    <Description>Installer for OpenClevo.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <!-- one self-contained-looking file: the setup and the uninstaller copy run from a single exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- the app, zipped by build.ps1 -->
    <EmbeddedResource Include="Payload.zip" LogicalName="Payload.zip" />
    <!-- the same UI text and markup extension as the app -->
    <EmbeddedResource Include="..\..\langs\*.json" LogicalName="langs/%(Filename)%(Extension)" />
    <Compile Include="..\OpenClevo.App\Localization\Loc.cs" Link="Localization\Loc.cs" />
    <Compile Include="..\OpenClevo.App\Localization\TExtension.cs" Link="Localization\TExtension.cs" />
  </ItemGroup>

</Project>
